DATABASE_URL=
OPENAI_API_KEY=
# Twilio — voice only (numbers, incoming calls). WhatsApp no longer uses Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Meta WhatsApp Cloud API (secrets — never commit real values)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
META_WEBHOOK_VERIFY_TOKEN=     # any random string; must match the value set in the Meta webhook config
# Public domain/hostname used by the reverse proxy to route requests to this service, e.g. "api.example.com"
VIRTUAL_HOST=
JWT_SECRET=
CORS_ORIGIN=